# Cache rules for the CMS - config must NEVER come from browser cache,
# otherwise edits to admin/config.yml look like they did nothing.
/admin/config.yml
  Cache-Control: no-store, must-revalidate

/admin/index.html
  Cache-Control: no-store

/admin/
  Cache-Control: no-store

# Self-hosted CMS bundle - pinned bytes, safe to cache forever
/admin/vendor/decap-cms.js
  Cache-Control: public, max-age=31536000, immutable

/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
